# ----------------------------------------------------------------------------
# Desktop environment.
# ----------------------------------------------------------------------------
{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:

let
  dotfiles = ../../config;
  cfg = config.desktop;
  username = config.core.username;

  # conf/monitors.lua
  monitorsLua =
    "-- Generated by nix (modules/desktop.nix). Rebuilds replace it.\n\n"
    + "return {\n"
    + lib.concatMapStrings (
      m:
      "\t{ output = ${builtins.toJSON m.output}, mode = ${builtins.toJSON m.mode}, "
      + "position = ${builtins.toJSON m.position}, scale = ${builtins.toJSON m.scale} },\n"
    ) cfg.monitors
    + "}\n";
in
{
  # per-host knobs
  # ---------------------------------------------
  options.desktop = {
    monitors = lib.mkOption {
      type = lib.types.listOf (
        lib.types.submodule {
          options = {
            output = lib.mkOption {
              type = lib.types.str;
              default = "";
              description = "Output name (see hyprctl monitors); empty matches every output.";
            };
            mode = lib.mkOption {
              type = lib.types.str;
              default = "preferred";
              description = "Resolution and refresh rate, e.g. 2560x1600@60.";
            };
            position = lib.mkOption {
              type = lib.types.str;
              default = "auto";
              description = "Placement in the layout, e.g. 0x0.";
            };
            scale = lib.mkOption {
              type = lib.types.number;
              default = 1;
              description = "Output scale factor.";
            };
          };
        }
      );
      default = [ ];
      description = "Display rules for this host, written to the hypr state file.";
    };

    wallpaperDirectory = lib.mkOption {
      type = lib.types.str;
      default = "~/Resources/media/pictures/wallpaper/landscape";
      description = "Directory noctalia picks wallpapers from.";
    };
  };

  config = {
    # hyprland
    # ---------------------------------------------
    programs.hyprland.enable = true;
    xdg.portal.extraPortals = [ pkgs.xdg-desktop-portal-gtk ];
    programs.dconf.enable = true;

    # nixpkgs keeps schemas in a layout the plain gsettings CLI never
    # searches; without this every `gsettings set` fails
    environment.sessionVariables.XDG_DATA_DIRS = [
      "${pkgs.gsettings-desktop-schemas}/share/gsettings-schemas/${pkgs.gsettings-desktop-schemas.name}"
    ];

    # audio
    # ---------------------------------------------
    security.rtkit.enable = true;
    services.pipewire = {
      enable = true;
      alsa.enable = true;
      pulse.enable = true;
    };

    # packages
    # ---------------------------------------------
    environment.systemPackages = with pkgs; [
      # desktop shell
      inputs.noctalia.packages.${stdenv.hostPlatform.system}.default
      libnotify

      # terminal & viewers
      kitty
      zathura
      cava

      # themes
      capitaine-cursors
      (tela-circle-icon-theme.override { colorVariants = [ "black" ]; })
      glib
      gsettings-desktop-schemas
    ];

    fonts.packages = with pkgs; [
      inter
      noto-fonts-cjk-sans
      nerd-fonts.code-new-roman
      nerd-fonts.jetbrains-mono
      udev-gothic-nf
    ];


    # home-manager
    # ---------------------------------------------
    home-manager.users.${username} = {
      xdg.configFile =
        let
          desktopDirs = [
            "gtk-3.0"
            "gtk-4.0"
            "hypr"
            "kitty"
            "noctalia"
            "zathura"
          ];
        in
        lib.genAttrs desktopDirs (dir: {
          source = dotfiles + "/config/${dir}";
          recursive = true;
        })
        // {
          # per-host values, merged over config.toml (zz- sorts last)
          "noctalia/zz-host.toml".text = ''
            # Host overlay, rendered by nix (modules/desktop.nix).

            [wallpaper]
            directory = "${cfg.wallpaperDirectory}"
          '';
        };

      # local plugins load from XDG data
      xdg.dataFile."noctalia/plugins" = {
        source = dotfiles + "/share/noctalia/plugins";
        recursive = true;
      };

      # per-host display rules for conf/monitors.lua
      xdg.stateFile = lib.mkIf (cfg.monitors != [ ]) {
        "hypr/monitors.lua".text = monitorsLua;
      };
    };
  };
}
