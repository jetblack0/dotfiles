#!/usr/bin/env bash 

set -eo pipefail

BOLD=$'\033[1m'
UNDERLINE=$'\033[4m'
NC=$'\033[0m'
GREEN=$'\033[32m'
RED=$'\033[31m'
YELLOW=$'\033[33m'

CMD_ABSOPATH="$(realpath "$0")"

TEMPLATES_SINGBOX=("singbox@.service" "singbox.target")
TEMPLATES_MIHOMO=("mihomo@.service" "mihomo.target")

SUPPORTED_COMMANDS=(install uninstall stopall restart)
SUPPORTED_PERSONAL_COMMANDS=(genconf)

declare -Ag SUPPORTED_MIHOMO_GUIS=(
  [yacd]="https://github.com/haishanh/yacd"
  [metacubexd]="https://github.com/MetaCubeX/metacubexd"
)

declare -Ag SUPPORTED_TARGETS=(
  [mihomo]="https://github.com/MetaCubeX/mihomo"
  [singbox]="https://github.com/SagerNet/sing-box"
)


##############################
# Usage
##############################
function usage_synopsis() {
  cat <<EOF
${BOLD}${UNDERLINE}Usage${NC}: ${BOLD}${0}${NC} <COMMAND> [<options>]
       ${BOLD}${0}${NC} [ -h | --help ] [ -g | --list-guis ] [ -l | --list-tools ]
       ${BOLD}${0}${NC} [ -h | --help ] <COMMAND>
EOF
}

function usage_description() {
  cat <<EOF
A simple script for managing various proxy tools that I use. Requires root
privileges. 
EOF
}

function usage_options() {
  cat <<EOF
${BOLD}${UNDERLINE}Commands${NC}:
  install               Install proxy tools
  uninstall             Uninstall everything created by the install command
  stopall               Stop all running proxy instances
  restart               Stop all running proxy instances

${BOLD}${UNDERLINE}Options${NC}:
  -g, --list-guis       List supported mihomo GUIs
  -l, --list-tools      List supported proxy tools
  -h, --help            Print help
EOF
}

function usage() {
  usage_synopsis
  echo
  usage_description
  echo
  usage_options
}

function usage_synopsis_install() {
  cat <<EOF
${BOLD}${UNDERLINE}Usage${NC}: ${BOLD}${0}${NC} install [-t | --target [<tool>]] [-d | --bin-dir [<dir>]]
       [-f | --force] [-p | --systemd-prefix [<dir>]] [-g | --gui [<gui>]]
EOF
}

function usage_description_install() {
  cat <<EOF
Install a proxy tool.
EOF
}

function usage_options_install() {
  cat <<EOF
${BOLD}${UNDERLINE}Options${NC}:
${BOLD}  -t, --target <tool>${NC}   
      Install specified proxy tool

      Possible values:
      - singbox: ${SUPPORTED_TARGETS[singbox]}
      - mihomo: ${SUPPORTED_TARGETS[mihomo]}

      [default: singbox] 

${BOLD}  -d, --bin-dir <dir>${NC}
      The directory in which the binary should be placed

      [default: /usr/local/bin] 

${BOLD}  -f, --force${NC}
      Forces the installation to proceed even if the destination files already exist

${BOLD}  -p, --systemd-prefix${NC}
      The directory in which the Systemd units should be placed 

      [default: /etc/systemd/system] 

${BOLD}  -g, --gui${NC}
      Install specified mihomo web GUI, will be silently ignored when used with
      other tools (Singbox supports the use of web GUI from the configuration
      file).

      Possible values:
      - yacd: ${SUPPORTED_MIHOMO_GUIS[yacd]}
      - metacubexd: ${SUPPORTED_MIHOMO_GUIS[metacubexd]}

    [default: metacubexd] 
EOF
}

function usage_synopsis_uninstall() {
  cat <<EOF
${BOLD}${UNDERLINE}Usage${NC}: ${BOLD}${0}${NC} uninstall [-t | --target [<tool>]] [-f | --force]
       [-p | --systemd-prefix [<dir>]]
EOF
}

function usage_description_uninstall() {
  cat <<EOF
Uninstall a proxy tool.
EOF
}

function usage_options_uninstall() {
  cat <<EOF
${BOLD}${UNDERLINE}Options${NC}:
${BOLD}  -t, --target <tool>${NC}   
      The proxy tool to uninstall

      Possible values:
      - singbox
      - mihomo

      [default: singbox] 

${BOLD}  -f, --force${NC}
      Forces uninstallation to proceed even if there are profiles found in the directory

${BOLD}  -p, --systemd-prefix${NC}
      The directory in which the Systemd units are installed

      [default: /etc/systemd/system] 
EOF
}

function usage_synopsis_stopall() {
  cat <<EOF
${BOLD}${UNDERLINE}Usage${NC}: ${BOLD}${0}${NC} stopall [-t | --target [<tool>]]
EOF
}

function usage_description_stopall() {
  cat <<EOF
Stop all running instance for a proxy tool.
EOF
}

function usage_options_stopall() {
  cat <<EOF
${BOLD}${UNDERLINE}Options${NC}:
${BOLD}  -t, --target <tool>${NC}   
      Stop all running instances for the specified proxy

      Possible values:
      - singbox
      - mihomo

      [default: singbox] 
EOF
}

function usage_synopsis_restart() {
  cat <<EOF
${BOLD}${UNDERLINE}Usage${NC}: ${BOLD}${0}${NC} restart [-t | --target [<tool>]]
EOF
}

function usage_description_restart() {
  cat <<EOF
Restart all running instance for a proxy tool.
EOF
}

function usage_options_restart() {
  cat <<EOF
${BOLD}${UNDERLINE}Options${NC}:
${BOLD}  -t, --target <tool>${NC}
      Restart all running instances for the specified proxy

      Possible values:
      - singbox
      - mihomo

      [default: singbox]
EOF
}

function usage_subcommand() {
  local subcommand="$1"
  usage_synopsis_"$subcommand"
  echo
  usage_description_"$subcommand"
  echo
  usage_options_"$subcommand"
}


##############################
# Helpers
##############################
function expand_units_with_prefix() {
  local prefix="$1"
  shift
  declare -n _ref="$1"
  shift
  local units=("$@")

  _ref=()
  for unit in "${units[@]}"; do
    _ref+=("$prefix/$unit")
  done
}

function array_contains_element() {
  local needle="$1" array="$2"

  for element in $array; do
    [ "$element" = "$needle" ] && return 0
  done
  return 1
}

function log() {
  local message="$1"
  local type=${2:-"normal"}
  local indent

  case "$3" in
    1)
      indent="==> "
      ;;
    2)
      indent="  -> "
      ;;
    3)
      indent="    → "
      ;;
  esac

  case "$type" in
    skip)   echo "${BOLD}${YELLOW}${indent}Skip: $message${NC}"    ;;
    abort)  echo "${BOLD}${indent}Abort: $message${NC}"            ;;
    error)  echo "${BOLD}${RED}${indent}ERROR: $message${NC}" >&2  ;;
    errorn) echo "${BOLD}${indent}$message${NC}" >&2               ;;
    warn)   echo "${BOLD}${YELLOW}${indent}WARNING: $message${NC}" ;;
    *)      echo "${BOLD}${GREEN}${indent}${NC}$message"           ;;
  esac
}

function log_cmd() {
  set +e
  local indent=0

  if [[ "$1" =~ ^[0-9]+$ ]]; then
    indent="$1"
    shift
  fi

  local cmd_output
  if cmd_output="$("$@" 2>&1)"; then
    [ -n "$cmd_output" ] && log "$1: $cmd_output" normal "$indent"
  else
    [ -n "$cmd_output" ] && log "$1: $cmd_output" error "$indent"
  fi
  set -e
}


##############################
# Checks
##############################
function is_cmd_exist() {
  for command in "$@"; do
    if ! type -p "$command" > /dev/null 2>&1; then
      return 1
    fi
  done
  return 0
}

function is_euid_root() {
  if [ "$EUID" -eq 0 ]; then 
    return 0
  fi
  return 1
}

function is_user_exist() {
  if getent passwd "$1" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

function is_group_exist() {
  if getent group "$1" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

function is_conf_exist() {
  for conf in "$@"; do
    if [ ! -f "$conf" ]; then
      return 1
    fi
  done
  return 0
}


##############################
# Mains
##############################
function get_subcommands() {
  [ "$#" -eq 0 ] && {
    usage
    exit 0
  }

  local supported_command_pattern supported_personal_command_pattern
  supported_command_pattern=$(IFS="|"; echo "@(${SUPPORTED_COMMANDS[*]})")
  supported_personal_command_pattern=$(IFS="|"; echo "@(${SUPPORTED_PERSONAL_COMMANDS[*]})")

  shopt -s extglob
  case "$1" in
    $supported_command_pattern)
      COMMAND="$1"
      ;;
    $supported_personal_command_pattern)
      COMMAND="$1"
      ;;
    -h|--help)
      if [ -n "$2" ]; then
        case "$2" in
          $supported_command_pattern)
            usage_subcommand "$2"
            exit 0
            ;;
          $supported_personal_command_pattern)
            log "No help menu available" warn
            exit 0
            ;;
          *)
            log "unrecognized command: $2" error
            exit 1
            ;;
        esac
      fi
      usage
      exit 0
      ;;
    -g|--list-guis)
      log "Supported mihomo GUIs:" normal
      for i in "${!SUPPORTED_MIHOMO_GUIS[@]}"; do
        echo "- $i: ${SUPPORTED_MIHOMO_GUIS[$i]}" 
      done
      exit 0 
      ;;
    -l|--list-tools)
      log "Supported proxy tools:" normal
      for i in "${!SUPPORTED_TARGETS[@]}"; do
        echo "- $i: ${SUPPORTED_TARGETS[$i]}" 
      done
      exit 0 
      ;;
    *)
      log "unrecognized command: $1" error
      usage_options >&2
      exit 1
      ;;
  esac
  shopt -u extglob
}

function get_opts_install() {
  while [ $# -gt 0 ]; do
    case $1 in
      -t|--target)
        [ -z "$2" ] && {
          log "Argument for proxy tool (-t|--target) is empty, using default (singbox)" warn
          shift
          continue
        }

        if ! array_contains_element "$2" "${!SUPPORTED_TARGETS[*]}"; then
          log "Unsupported tool '$2', can only be one of:" error

          for i in "${!SUPPORTED_TARGETS[@]}"; do
            log "$i: ${SUPPORTED_TARGETS[$i]}" errorn 2
          done

          exit 1
        fi

        TARGET="$2"
        shift
        ;;
      -d|--bin-dir)
        [ -z "$2" ] && {
          log "Argument for binary installation directory is empty, using default (/usr/local/bin)" warn
          shift
          continue
        }

        if [ -d "$2" ]; then
          log "No such directory: $2" error
          exit 1
        fi

        BIN_DIR="$2"
        shift
        ;;
      -f|--force)
        FORCE=true
        ;;
      -p|--systemd-prefix)
        [ -z "$2" ] && {
          log "Argument for systemd directory is empty, using default (/etc/systemd/system)" warn
        }

        if [ -d "$2" ]; then
          log "No such directory: $2" error
          exit 1
        fi

        SYSTEMD_PREFIX="$2"
        shift
        ;;
      -g|--gui)
        [ -z "$2" ] && {
          log "Argument for mihomo GUI is empty, using default (metacubexd)" warn
          INSTALL_MIHOMO_GUI=true
          shift
          continue
        }

        [ "$TARGET" = "singbox" ] && {
          log "GUI option will be silently ignored" warn
          shift 2 
          continue
        }

        if ! array_contains_element "$2" "${!SUPPORTED_MIHOMO_GUIS[*]}"; then
          log "Unsupported GUI '$2', can only be one of:" error 1

          for i in "${!SUPPORTED_MIHOMO_GUIS[@]}"; do
            log "$i: ${SUPPORTED_MIHOMO_GUIS[$i]}" errorn 2
          done

          exit 1
        fi

        INSTALL_MIHOMO_GUI=true
        MIHOMO_GUI="$2"
        shift
        ;;
      # NOTE: personal options that are specific to my own environment, won't show up in
      # the help menu
      --genconf)
        [ "$TARGET" != "mihomo" ] && {
          log "genconf option will be silently ignored" warn
          shift 1 
          continue
        }

        GENCONF=true
        ;;
      --prestart)
        [ "$TARGET" != "mihomo" ] && {
          log "prestart option will be silently ignored" warn
          shift 1 
          continue
        }

        PRESTART=true
        ;;
      --mihomo-suspend)
        [ "$TARGET" != "mihomo" ] && {
          log "suspend option will be silently ignored" warn
          shift 1
          continue
        }

        MIHOMO_SUSPEND=true
        ;;
      --slice)
        SLICE=true
        ;;
      --personal-mihomo)
        [ "$TARGET" != "mihomo" ] && {
          log "personal option will be silently ignored" warn
          shift 1
          continue
        }

        GENCONF=true
        PRESTART=true
        MIHOMO_SUSPEND=true
        SLICE=true
        ;;
      --personal-singbox)
        [ "$TARGET" != "singbox" ] && {
          log "personal option will be silently ignored" warn
          shift 1
          continue
        }

        SLICE=true
        ;;
      *)
        log "unrecognized option: $1" error
        usage_synopsis_install >&2
        exit 1
        ;;
    esac

    shift
  done
}

function get_opts_uninstall() {
  while [ $# -gt 0 ]; do
    case $1 in
      -t|--target)
        [ -z "$2" ] && {
          log "Argument for proxy tool (-t|--target) is empty, using default (singbox)" warn
