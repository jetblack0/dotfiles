function mk_singbox_systemd() {
  cat > "$SYSTEMD_PREFIX"/singbox.target <<EOF
Description=Passive target unit for singbox@.service
After=network.target
RefuseManualStart=yes
EOF

  $SLICE && local slice="Slice=service.slice"

  cat > "$SYSTEMD_PREFIX"/singbox@.service <<EOF
[Unit]
Description=Sing-box proxy using configuration file /etc/singbox/profiles/%i.yaml
After=network.target nss-lookup.target network-online.target
Wants=singbox.target
PartOf=singbox.target

[Service]
User=singbox
Group=singbox
$slice
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_TIME CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_TIME CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
ExecStartPre=/bin/sh -c '/usr/bin/env yq -o=json /etc/singbox/profiles/%i.yaml > /run/singbox-%i.json'
ExecStart=$BIN_DIR/singbox run -c /run/singbox-%i.json -D /etc/singbox
ExecReload=/bin/kill -HUP \$MAINPID
ExecStopPost=/bin/rm -f /run/singbox-%i.json
Restart=on-failure
RestartSec=10
LimitNPROC=512
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
EOF
}

function mk_mihomo_systemd() {
  cat > "$SYSTEMD_PREFIX"/mihomo.target <<EOF
Description=Passive target unit for mihomo@.service
After=network.target
RefuseManualStart=yes
EOF

  $GENCONF && local gen_conf_pre="ExecStartPre=$CMD_ABSOPATH genconf"
  $PRESTART && local prestart_conf_pre="ExecStartPre=$CMD_ABSOPATH stopall"
  $SLICE && local slice="Slice=service.slice"

  cat > "$SYSTEMD_PREFIX"/mihomo@.service <<EOF
[Unit]
Description=mihomo Daemon using configuration file /etc/mihomo/profiles/%i.yaml
Documentation=https://wiki.metacubex.one
After=network.target nss-lookup.target network-online.target
Wants=mihomo.target
PartOf=mihomo.target

[Service]
Type=exec
User=mihomo
Group=mihomo
$slice
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_TIME CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_TIME CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
WorkingDirectory=/etc/mihomo
$gen_conf_pre
$prestart_conf_pre
ExecStart=$BIN_DIR -d /etc/mihomo -f /etc/mihomo/profiles/%i.yaml
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=10
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
EOF
}

function download_release() {
  local release="$1"
  local latest_version os arch
  local repo suffix

  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m)

  case "$arch" in
    x86_64)   arch="amd64" ;;
    aarch64)  arch="arm64" ;;
    armv7l)   arch="armv6" ;;
    i386)     arch="386"   ;;
    i686)     arch="386"   ;;
    riscv64)  arch="riscv64" ;;
    *)        log "Unsupported architecture: $arch" error; exit 1 ;;
  esac

  case "$release" in
    mihomo)
      repo=MetaCubeX/mihomo
      ;;
    singbox)
      repo="SagerNet/sing-box"
      ;;
    metacubexd)
      repo="MetaCubeX/metacubexd"
      suffix="compressed-dist.tgz" 
      ;;
    yacd)
      repo="haishanh/yacd"        
      suffix="yacd.tar.xz"
      ;;
  esac

  latest_version=$(curl -sL "https://api.github.com/repos/$repo/tags" | jq -r \
    '.[0].zipball_url' | awk -F '/' '{print $(NF)}')

  case "$release" in
    mihomo) suffix="mihomo-$os-$arch-$latest_version.gz" ;;
    singbox) suffix="sing-box-${latest_version#v}-$os-$arch.tar.gz" ;;
  esac

  log "Downloading $release latest version: $latest_version" normal 2

  curl --retry 3 --remove-on-error -Lo \
    "/tmp/$suffix" \
    "https://github.com/$repo/releases/download/$latest_version/\
$suffix"

  log "Successfully downloaded latest release to /tmp/$suffix" \
    normal 2

  declare -n _ref="$2"
  _ref=("$suffix")
}

function install() {
  local -n templates="TEMPLATES_${TARGET^^}"

  local create_group=false create_user=false create_systemd_service=false \
    download_binary=false create_conf_dir=false

  local create_suspend_service=false

  local expanded_units=()

  expand_units_with_prefix "$SYSTEMD_PREFIX" expanded_units "${templates[@]}"

  is_group_exist "$TARGET" || create_group=true
  is_user_exist "$TARGET" || create_user=true
  is_cmd_exist "$TARGET" || download_binary=true
  is_conf_exist "${expanded_units[@]}" || create_systemd_service=true
  [ -d "/etc/$TARGET/profiles"  ] || create_conf_dir=true

  if $MIHOMO_SUSPEND && [ "$(systemctl is-enabled mihomo-restart.service)" \
    != "enabled" ]; then
      create_suspend_service=true
  fi

  # NOTE: if configuration directory already exists, this won't
  # try to update its permissions or anything, unless -f is given.
  # the intention is to prevent breaking existing setup.
  if ! $create_group \
    && ! $create_systemd_service \
    && ! $create_user \
    && ! $download_binary \
    && ! $create_conf_dir \
    && ! $FORCE \
    && ! ($INSTALL_MIHOMO_GUI && [ "$TARGET" = "mihomo" ]) \
    && ! $create_suspend_service; then

    log "Nothing else to do, quit" abort 1
    exit 0
  fi

  log "Installing $TARGET" normal 1

  if $create_user && $create_group; then
    log "Creating user and group $TARGET" normal 2
    useradd -s "$(which nologin)" -M -d /nonexistent -r "$TARGET"
  elif $create_user; then
    log "Creating user $TARGET" normal 2
    useradd -s "$(which nologin)" -M -d /nonexistent -rN "$TARGET"
  elif $create_group; then
    log "Creating group $TARGET" normal 2
    groupadd --system "$TARGET"
  else
    log "User and group $TARGET already exist" skip 2
  fi

  if $create_systemd_service || $FORCE; then
    log "Creating $TARGET Systemd services" normal 2
    mk_"$TARGET"_systemd
    systemctl daemon-reload
  else
    log "Found systemd unit files" skip 2
  fi

  if $download_binary || $FORCE ; then
    local result dest
    local suffix

    dest="$BIN_DIR/$TARGET"
    download_release "$TARGET" result
    suffix=${result[0]}

    case "$TARGET" in
      mihomo)
        gzip -dc /tmp/"$suffix" > \
          "$dest"
        ;;
      singbox)
        tar xf /tmp/"$suffix" \
          -C "$BIN_DIR" \
          --strip-components=1 \
          "${suffix%%.tar.gz}"/sing-box

        mv "$BIN_DIR"/sing-box "$BIN_DIR"/singbox
        ;;
    esac
    chmod a+x "$dest"
  else
    log "Binary exists" skip 2
  fi

  if $create_conf_dir || $FORCE; then
    log "Creating configuration directory" normal 2
    mkdir -p /etc/"$TARGET"/profiles
    chmod 0775 /etc/"$TARGET"
    chmod 0770 /etc/"$TARGET"/profiles
  else
    log "Configuration directory exists" skip 2
  fi

  # mihomo specific
  if [ "$TARGET" = "mihomo" ] && $INSTALL_MIHOMO_GUI; then
    local strip_component

    mkdir -p "$MIHOMO_GUI_DIR"/"$MIHOMO_GUI"
    chmod 0775 "$MIHOMO_GUI_DIR"
    chmod 0775 "$MIHOMO_GUI_DIR"/"$MIHOMO_GUI"

    case "$MIHOMO_GUI" in
      metacubexd) strip_component=0 ;;
      yacd)       strip_component=1 ;;
    esac

    download_release "$MIHOMO_GUI" result
    suffix=${result[0]}

    tar xf /tmp/"$suffix" \
      --strip-components="$strip_component" \
      --directory="$MIHOMO_GUI_DIR"/"$MIHOMO_GUI"
  fi

  if [ "$TARGET" = "mihomo" ] && $MIHOMO_SUSPEND; then
    log "Creating mihomo-restart service" normal 2

    cat > "$SYSTEMD_PREFIX"/mihomo-restart.service <<EOF
[Unit]
Description=Restart mihomo instances after waking up from suspension
After=suspend.target

[Service]
Type=oneshot
ExecStart=$CMD_ABSOPATH restart

[Install]
WantedBy=suspend.target
EOF

  systemctl daemon-reload
  log_cmd 3 systemctl enable mihomo-restart.service
  fi

  chown -R "$TARGET":"$TARGET" /etc/"$TARGET"
  log "Done." normal 2
}

# TODO: indicate if there is nothing else left to do
function uninstall() {
  local -n templates="TEMPLATES_${TARGET^^}"

  local remove_group=false remove_user=false remove_binary=false \
    all_units_exist=false config_dir_exist=false

  local remove_mihomo_restart_service=false

  local expanded_units=()

  expand_units_with_prefix "$SYSTEMD_PREFIX" expanded_units "${templates[@]}"

  is_user_exist "$TARGET" && remove_user=true
  is_cmd_exist "$TARGET" && remove_binary=true
  is_conf_exist "${expanded_units[@]}" && all_units_exist=true
  [ -d /etc/"$TARGET" ] && config_dir_exist=true

  if [ "$TARGET" = "mihomo" ] && \
    systemctl list-unit-files "mihomo-restart.service" &>/dev/null; then
    remove_mihomo_restart_service=true
  fi

  local profiles
  [ -d /etc/"$TARGET"/profiles ] && {
    readarray -t profiles < <(find /etc/"$TARGET"/profiles -type f -name '*.yaml' \
      -or -name '*.yml' | sed '/^$/d')
  }

  log "Uninstalling $TARGET" normal 1

  if $remove_user; then
    log "Removing user $TARGET" normal 2

    if $config_dir_exist && [ "$(stat -c '%U' /etc/"$TARGET")" = "$TARGET" ]; then
      chown root /etc/"$TARGET"
    fi
    log_cmd 3 userdel "$TARGET"
  else
    log "User $TARGET doesn't exist" skip 2
  fi

  is_group_exist "$TARGET" && remove_group=true

  if $remove_group; then
    log "Removing group $TARGET" normal 2

    if $config_dir_exist && [ "$(stat -c '%G' /etc/"$TARGET")" = "$TARGET" ]; then
      chown :root /etc/"$TARGET"
    fi
    log_cmd 3 groupdel "$TARGET"
  else
    log "Group $TARGET doesn't exist" skip 2
  fi

  if $remove_binary; then
    log "Removing binary $(which "$TARGET")" normal 2
    rm "$(which "$TARGET")"
  else
    log "Binary doesn't exist" skip 2
  fi

  if ! $all_units_exist; then
    log "No units files" skip 2
  else
    for profile in "${profiles[@]}"; do
      local initialized_unit="${TARGET}"@"${profile}".service
      systemctl is-enabled "$initialized_unit" &>/dev/null && \
        systemctl disable "$initialized_unit"
    done

    for unit in "${expanded_units[@]}"; do
      log "Removing unit file: $unit" normal 2
      [ -f "$unit" ] && rm "$unit"
    done
  fi

  if ! $config_dir_exist; then
    log "Directory /etc/$TARGET does not exist" skip 2
  elif [ ${#profiles[@]} -eq 0 ] || $FORCE; then
    log "Removing directory /etc/$TARGET" normal 2
    rm -rf /etc/"$TARGET"
  else
    log "Found profiles in /etc/$TARGET/profiles" skip 2
  fi

  if $remove_mihomo_restart_service; then
    log "Removing mihomo-restart.service" normal 2
    if [ "$(systemctl is-enabled mihomo-restart.service)" = "enabled" ]; then
      log_cmd 3 systemctl disable mihomo-restart.service
    fi

    rm "$SYSTEMD_PREFIX"/mihomo-restart.service
    systemctl daemon-reload
  fi

  log "Done." normal 2
}

function stopall() {
  log "Stopping all running instances of $TARGET" normal 1
  if ! systemctl list-unit-files "$TARGET".target &>/dev/null; then
    log "$TARGET.target doesn't exist" error 2
    log "maybe try '$0 install -t $TARGET' first" error 2
    exit 1
  fi

  systemctl is-active "$TARGET".target &>/dev/null || \
    log "Doesn't seem to have running instance for $TARGET" warn 2

  systemctl stop "$TARGET".target
  log "Done." normal 2
}

function restart() {
  if ! systemctl list-unit-files "$TARGET"@.service &>/dev/null; then
    log "$TARGET@.service doesn't exist" error 1
    log "maybe try '$0 install -t $TARGET' first" error 1
    exit 1
  fi

  if [ -z "$(systemctl show "$TARGET@*.service" -t service --state=active)" ]; then
    log "No active instances for $TARGET@.service" warn 1
    log "Nothing else to do, quit" abort 1
    exit 0
  fi

  log "Restart running instances of $TARGET" normal 1
  systemctl show "$TARGET@*.service" -t service --state=active --property=Id \
    --value --no-pager | while read -r unit; do
    if [ -n "$unit" ]; then
      log "Restarting unit $unit" normal 2
      systemctl restart "$unit"
    fi
  done

  log "Done." normal 2
}

function genconf() {
  local base_conf="/etc/mihomo/profiles/tun-dns.yaml"
  local proxy_conf="/etc/mihomo/profiles/proxy.yaml"
  local dns_conf="/etc/mihomo/profiles/dns.yaml"

  is_conf_exist $base_conf || {
    log "Base template '$base_conf' doesn't exist" error
    exit 1
  }

  log "Generating proxy and DNS configurations based on $base_conf" normal 2

  yq 'del(.tun)' $base_conf > $proxy_conf
  yq '.dns' $base_conf > $dns_conf

  chmod 0744 $dns_conf $proxy_conf
  log "Done." normal 2
}



function main() {
  COMMAND=
  get_subcommands "$@"
  shift

  case "$COMMAND" in
    install)
      : "${TARGET:="singbox"}"
      : "${SYSTEMD_PREFIX:="/etc/systemd/system"}"
      : "${BIN_DIR:="/usr/local/bin"}"
      : "${FORCE:=false}"
      # mihomo specific options
      : "${INSTALL_MIHOMO_GUI:=false}"
      : "${MIHOMO_GUI_DIR:="/etc/mihomo/guis"}"
      : "${MIHOMO_GUI:="metacubexd"}"
      # personal options
      : "${GENCONF:=false}"
      : "${PRESTART:=false}"
      : "${SLICE:=false}"
      : "${MIHOMO_SUSPEND:=false}"

      get_opts_install "$@" 

      is_cmd_exist "jq" "yq" || {
        log "Command jq or yq not found in PATH" error
        exit 1
      }

      is_euid_root || {
        log "please run as the root user" error
        exit 1
      } 

      [ "$(ps --no-headers -o ucmd -p 1)" != "systemd" ] && {
        log "non-systemd system, unsupported" error
        exit 1
      }

      install
      ;;
    uninstall)
      : "${TARGET:="singbox"}"
      : "${FORCE:=false}"
      # NOTE: I can find the path instead, but that would be too aggressive 
      : "${SYSTEMD_PREFIX:="/etc/systemd/system"}"
      get_opts_uninstall "$@" 

      is_euid_root || {
        log "please run as the root user" error
        exit 1
      } 

      [ "$(ps --no-headers -o ucmd -p 1)" != "systemd" ] && {
        log "non-systemd system, unsupported" error
        exit 1
      }
      uninstall
      ;;
    stopall)
      : "${TARGET:="singbox"}"
      get_opts_stopall "$@" 

      is_euid_root || {
        log "please run as the root user" error
        exit 1
      } 

      [ "$(ps --no-headers -o ucmd -p 1)" != "systemd" ] && {
        log "non-systemd system, unsupported" error
        exit 1
      }
      stopall
      ;;
    restart)
      : "${TARGET:="singbox"}"
      get_opts_restart "$@"

      is_euid_root || {
        log "please run as the root user" error
        exit 1
      }

      [ "$(ps --no-headers -o ucmd -p 1)" != "systemd" ] && {
        log "non-systemd system, unsupported" error
        exit 1
      }
      restart
      ;;
    genconf)
      # is_euid_root || {
      #   log "please run as the root user" error
      #   exit 1
      # } 

      is_cmd_exist "yq" || {
        log "Command yq not found in PATH" error
        exit 1
      }
      genconf
      ;;
  esac
}

main "$@"
