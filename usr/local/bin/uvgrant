#!/usr/bin/env bash

# Goal: A single universal vagrant environment that supposes all kinds of OSs and providers.  
# TODO:
# 1. Add options to list supported boxes and providers

set -o pipefail
set -o errexit

umask 0022

##############################
# Hardcoded variables
##############################
BOLD=$'\033[1m'
UNDERLINE=$'\033[4m'
NC=$'\033[0m'
GREEN=$'\033[32m'
RED=$'\033[31m'
YELLOW=$'\033[33m'

BASE_DIR="/tmp/uvgrant"
HOSTNAME_PREFIX="uvgrant"
SUPPORTED_PROVIDERS=("libvirt")
declare -A SUPPORTED_OS=(
  [debian12]="generic/debian12"
)


##############################
# Helpers
##############################
function log() {
  local message="$1"
  local type=${2:-"normal"}
  local indent

  case "$3" in
    1)
      indent="==> "
      ;;
    2)
      indent="  -> "
      ;;
    3)
      indent="    → "
      ;;
  esac

  case "$type" in
    skip)   echo "${BOLD}${YELLOW}${indent}Skip: $message${NC}"    ;;
    abort)  echo "${BOLD}${indent}Abort: $message${NC}"            ;;
    error)  echo "${BOLD}${RED}${indent}ERROR: $message${NC}" >&2  ;;
    errorn) echo "${BOLD}${indent}$message${NC}" >&2               ;;
    warn)   echo "${BOLD}${YELLOW}${indent}WARNING: $message${NC}" ;;
    *)      echo "${BOLD}${GREEN}${indent}${NC}$message"           ;;
  esac
}

function ip2int() {
  local IFS=. 
  read -r o1 o2 o3 o4 <<< "$1"
  echo $(( (o1 << 24) + (o2 << 16) + (o3 << 8) + o4 ))
}

function prefix2maskint() {
  local prefix=$1
  echo $(( 0xFFFFFFFF << (32 - prefix) & 0xFFFFFFFF ))
}


##############################
# Conditions
##############################
function is_array_contains_element() {
  local needle="$1" array="$2"

  for element in $array; do
    [ "$element" = "$needle" ] && return 0
  done
  return 1
}

function is_unsigned_int() {
  re='^[0-9]+$'
  if ! [[ $1 =~ $re ]] ; then
    return 1
  fi

  return 0
}


##############################
# Checks
##############################
function checkget_ipcidr() {
  local cidr=$1
  local ip prefix network_int ip_int netmask

  IFS=/ read -r ip prefix <<< "$cidr"

  if [[ ! $cidr =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]; then
    log "Invalid IPv4 CIDR format: '$cidr'" error 
    exit 1
  fi

  if [ "$prefix" -lt 0 ] || [ "$prefix" -gt 32 ]; then
    log "Invalid prefix length: '$prefix'" error
    exit 1
  fi

  IFS=. read -r o1 o2 o3 o4 <<< "$ip"
  for octet in $o1 $o2 $o3 $o4; do
    if [ "$octet" -lt 0 ] || [ "$octet" -gt 255 ]; then
      log "Invalid octet $octet" error
      exit 1
    fi
  done

  if [ "$prefix" -eq 0 ]; then
    netmask=0
  else
    netmask=$(prefix2maskint "$prefix")
  fi

  ip_int=$(ip2int "$ip")
  network_int=$(( ip_int & netmask ))

  if (( ip_int != network_int )); then
    log "Invalid CIDR: host bits are not zero" error
    exit 1
  fi

  [ -z "$2" ] && return 0

  local broadcast_int usable_ips

  broadcast_int=$(( network_int | ~netmask & 0xFFFFFFFF ))
  usable_ips=$(( (broadcast_int - network_int + 1) - 2 ))
  declare -n _ref="$2"
  _ref=("$ip_int" "$network_int" "$usable_ips" "$prefix")
}



##############################
# Usage
##############################
function usage_synopsis() {
  cat <<EOF
${BOLD}${UNDERLINE}Usage${NC}: ${BOLD}${0}${NC} [<options>] [-- <vagrant-args>...]
       ${BOLD}${0}${NC} [ -h | --help ]
       ${BOLD}${0}${NC} [ -l | --list-supported ]
       ${BOLD}${0}${NC} [ --list-providers ]
       ${BOLD}${0}${NC} [ --list-boxes ]
EOF
}

function usage_description() {
  cat <<EOF
A wrapper script for Vagrant that creates a generic Vagrant environment based
on given options. Arguments after -- are passed directly to vagrant.
EOF
}

function usage_options() {
  cat <<EOF
${BOLD}${UNDERLINE}Options${NC}:
${BOLD}  -p, --provider <provider>${NC}
      The Vagrant provider to use

      Possible values:
      - libvirt

      [default: libvirt]

${BOLD}  -o, --os <list>${NC}
      Comma-separated list of guest OS images to use. For example,
      --os "debian12,debian12" creates two machines both using the debian12 OS
      image

      Possible values:
      - debian12

      [default: debian12]

${BOLD}  -4, --ipv4-cidr <cidr>${NC}
      IPv4 CIDR block for the private network. Each VM will get an IPv4 address
      starting from the second address within the range, and stop at the last

      Note: CIDR other than 24 it not supported by vagrant-libvirt at this moment

      [default: 172.28.128.0/24]

${BOLD}  -m, --memory <MB>${NC}
      The amount of memory (in MB) allocated to all the VMs

      [default: 1024]

${BOLD}  -c, --cpu <integer>${NC}
      The amount of CPU cores allocated to all the VMs

      [default: 1]

${BOLD}  -h, --help${NC}
      Show this help message and exit

${BOLD}  -l, --list-supported${NC}
      List all the supported OS images and providers

${BOLD}  --list-boxes${NC}
      List all the supported OS images

${BOLD}  --list-providers${NC}
      List all the supported providers
EOF
}

function usage() {
  usage_synopsis
  echo
  usage_description
  echo
  usage_options
}



##############################
# Options and args
##############################
function get_opts() {
  local number_of_arguments=0

  while [ $# -gt 0 ]; do
    case $1 in
      -h|--help)
        usage
        exit 0
        ;;
      -p|--provider)
        (( ++number_of_arguments ))
        [ -z "$2" ] && {
          log "Argument for provider (-p|--provider) is empty, using default (libvirt)" warn
          shift
          continue
        }

        PROVIDER="$2"
        shift
        ;;
      -o|--os)
        (( ++number_of_arguments ))
        [ -z "$2" ] && {
          log "Argument for OS (-o|--os) is empty, using default (debian12)" warn
          shift
          continue
        }

        OS="$2"
        shift
        ;;
      -4|--ipv4-cidr)
        (( ++number_of_arguments ))
        [ -z "$2" ] && {
          log "Argument for IPv4 (-4|--ipv4-cidr) is empty, using default (172.28.128.0/24)" warn
          shift
          continue
        }

        IPV4_CIDR="$2"
        shift
        ;;
      -m|--memory)
        (( ++number_of_arguments ))
        [ -z "$2" ] && {
          log "Argument for memory (-m|--memory) is empty, using default (512 MiB)" warn
          shift
          continue
        }

        MEMORY="$2"
        shift
        ;;
      -c|--cpu)
        (( ++number_of_arguments ))
        [ -z "$2" ] && {
          log "Argument for cpu (-c|--cpu) is empty, using default (1)" warn
          shift
          continue
        }

        CPU="$2"
        shift
        ;;
      --list-boxes)
        log "Supported OS images:" normal
        for i in "${!SUPPORTED_OS[@]}"; do
          echo "- $i: ${SUPPORTED_OS[$i]}"
        done
        exit 0
        ;;
      --list-providers)
        log "Supported providers:" normal
        for provider in "${SUPPORTED_PROVIDERS[@]}"; do
          echo "- $provider"
        done
        exit 0
        ;;
      -l|--list-supported)
        log "Supported OS images:" normal
        for i in "${!SUPPORTED_OS[@]}"; do
          echo "- $i: ${SUPPORTED_OS[$i]}"
        done
        echo
        log "Supported providers:" normal
        for provider in "${SUPPORTED_PROVIDERS[@]}"; do
          echo "- $provider"
        done
        exit 0
        ;;
      --)
        if [ "$number_of_arguments" -eq 0 ]; then
          IS_VAGRANT_ARGS_ONLY_ARGUMENT=true
        fi

        shift
        VAGRANT_ARGS=("$@")
        break
        ;;
      *)
        log "unrecognized option: $1" error
        usage >&2
        exit 1
        ;;
    esac

    shift
  done
}

function checkset_opts() {
  case "$1" in
    provider)
      if ! is_array_contains_element "$PROVIDER" "${SUPPORTED_PROVIDERS[*]}"; then
        log "Unsupported provider '$PROVIDER', can only be one of:" error

        for provider in "${SUPPORTED_PROVIDERS[@]}"; do
          log "$provider" errorn 2
        done

        exit 1
      fi
      ;;
    os)
      local oss
      if [[ "$OS" == *,* ]]; then
        IFS=',' read -r -a oss <<< "$OS"
      else
        oss[0]="$OS"
      fi

      for ((i = 0; i < ${#oss[@]}; i++)); do
        local os
        os=${oss[$i]}

        if ! is_array_contains_element "$os" "${!SUPPORTED_OS[*]}"; then
          log "Unsupported os '$os', can only be one of:" error

          for j in "${!SUPPORTED_OS[@]}"; do
            log "$j: ${SUPPORTED_OS[$j]}" errorn 2
          done

          exit 1
        else
          BOXES[i]=${SUPPORTED_OS[$os]}
        fi
      done

      NUMBER_OF_NODES=${#BOXES[@]}
      ;;
    ipv4_cidr)
      local ip_info 

      checkget_ipcidr "$IPV4_CIDR" ip_info

      # TODO: Vagrant libvirt only supports 24 mask at this moment
      if [ ! "${ip_info[3]}" -eq 24 ]; then
        log "IPV4 CIDR other than 24 is not supported at this moment by vagrant-libvirt" error
        exit 1
      fi

      IPV4_NETWORK_INT=${ip_info[1]}
      IPV4_USABLE_IPS=${ip_info[2]}

      if [ "$NUMBER_OF_NODES" -gt "$IPV4_USABLE_IPS" ]; then
        log "Too many nodes '$NUMBER_OF_NODES', only $IPV4_USABLE_IPS usable in \
          $IPV4_CIDR" error
        exit 1
      fi
      ;;
    cpu)
      if ! is_unsigned_int "$CPU"; then
        log "'$CPU' is not a valid number for CPU cores" error
        exit 1
      fi

      local total_cpu
      total_cpu="$(nproc --all)"

      if [ "$CPU" -gt "$total_cpu" ]; then
        log "CPU can not be more than what's available memory on the system \
($total_cpu)" error
        exit 1
      fi
      ;;
    memory)
      if ! is_unsigned_int "$MEMORY"; then
        log "'$MEMORY' is not a valid number for memory" error
        exit 1
      fi

      local total_memory
      total_memory="$(free -m | awk 'NR==2{print $2}')"

      if [ "$MEMORY" -gt "$total_memory" ]; then
        log "Memory can not be more than what's available memory on the system \
($total_memory)" error
        exit 1
      fi
      ;;
    vagrant_args)
      if [ -z "$VAGRANT_ARGS" ]; then
        log "No arguments for vagrant are given. This will not bring up vagrant \
but only prepare the environment" warn
      fi
      ;;
    skip_mk_vagrantfile)
      if [ -f "$BASE_DIR"/Vagrantfile ] && $IS_VAGRANT_ARGS_ONLY_ARGUMENT ; then
        log "Skip generating Vagrantfile" warn
        SKIP_MK_VAGRANTFILE=true
      fi
      ;;
  esac
}

function mk_vagrantfile() {
  cat > "$BASE_DIR"/Vagrantfile <<EOF
Vagrant.require_version ">= 1.7.0"
VAGRANT_API_VERSION = "2"

BOXES = %w[${BOXES[@]}]
PROVIDER = "$PROVIDER"

Vagrant.configure(VAGRANT_API_VERSION) do |config|
  config.ssh.forward_agent = true
  config.ssh.keys_only = false
  config.ssh.insert_key = false

  config.vm.provision "file", source: ".vagrant/key.pub", destination: "/tmp/authorized_keys"
  config.vm.provision "shell", name: "Configure SSH keys", inline: <<-SHELL
    sudo test -d /root/.ssh || sudo mkdir -p /root/.ssh
    sudo chmod 0700 /root/.ssh

    cat /tmp/authorized_keys | sudo tee -a /root/.ssh/authorized_keys
    cat /tmp/authorized_keys >> /home/vagrant/.ssh/authorized_keys
  SHELL

  (1..$NUMBER_OF_NODES).each do |count|
    name = "$HOSTNAME_PREFIX-#{count}"
    ipv4 = [$IPV4_NETWORK_INT + count + 1].pack('N').unpack('CCCC').join('.')

    config.vm.define "#{name}" do |node|
      node.vm.hostname = "#{name}"
      node.vm.box = BOXES[count - 1]
      node.vm.box_check_update = false

      case PROVIDER
        when 'libvirt'
          node.vm.network :private_network,
            ip: "#{ipv4}",
            auto_config: true,
            libvirt__network_name: "uvgrant",
            libvirt__dhcp_enabled: false,
            libvirt__guest_ipv6: "no"
      end

      node.vm.provider :libvirt do |virt|
        virt.uri = 'qemu+unix:///system'
        virt.host = "#{node.vm.hostname}"
        virt.memory = $MEMORY
        virt.cpus = 1
      end
    end
  end
end
EOF
}

function prepare() {
  log "Preparing for the environment." normal 1

  # TODO: ugly
  if [ -d "$BASE_DIR" ]; then
    log "Directory $BASE_DIR exists" skip 2

    if [ ! -w "$BASE_DIR" ] || [ ! -r "$BASE_DIR" ] || [ ! -x "$BASE_DIR" ]; then
      log "Don't have sufficient privileges to $BASE_DIR" warn 2
      log "Trying to chmod $BASE_DIR to 07" warn 2

      if [ "$(stat -c '%U' $BASE_DIR)" = "$USER" ]; then
        chmod 0700 $BASE_DIR
      else
        log "Directory $BASE_DIR is not owned by the current user: $USER" error 2
        exit 1
      fi
    fi
  else
    log "Creating directory $BASE_DIR" normal 2

    if [ ! -w "$(dirname "$BASE_DIR")" ]; then
      log "Insufficient privileges to create $BASE_DIR" error 2
      exit 1
    else
      mkdir "$BASE_DIR" || {
        log "Error creating $BASE_DIR" error 2
        exit 1
      }
    fi
  fi

  [ ! -d "$BASE_DIR"/.vagrant ] && mkdir "$BASE_DIR"/.vagrant

  if [ ! -f "$BASE_DIR"/.vagrant/key ] || [ ! -f "$BASE_DIR"/.vagrant/key.pub ] ; then
    ssh-keygen -q -t ed25519 -N '' -f "$BASE_DIR"/.vagrant/key <<<y >/dev/null 2>&1
  fi

  log "Done." normal 2
}

function main() {
  : "${PROVIDER:="libvirt"}"
  : "${CPU:=1}"
  : "${MEMORY:=512}"
  : "${IPV4_CIDR:="172.28.128.0/24"}"
  : "${VAGRANT_ARGS:=}"
  : "${OS:="debian12"}"

  # derived from checkset_opts
  NUMBER_OF_NODES=
  IPV4_NETWORK_INT=
  IPV4_USABLE_IPS=
  declare -a BOXES

  SKIP_MK_VAGRANTFILE=false
  IS_VAGRANT_ARGS_ONLY_ARGUMENT=false

  get_opts "$@"
  checkset_opts provider
  checkset_opts os
  checkset_opts ipv4_cidr
  checkset_opts cpu
  checkset_opts memory
  checkset_opts vagrant_args
  checkset_opts skip_mk_vagrantfile

  $SKIP_MK_VAGRANTFILE || {
    prepare
    mk_vagrantfile
  }

  [ -n "$VAGRANT_ARGS" ] && {
    log "Handing controls over to vagrant" normal 1
    cd $BASE_DIR
    exec "$(command -v vagrant)" "${VAGRANT_ARGS[@]}"
  }

  exit 0
}

main "$@"
