#!/usr/bin/env bash
# QEMU virtual machines for testing the playbooks end to end, desktop
# included: a real boot, a real login and a real DRM display (virtio-gpu).
# Each vm is a named instance that keeps its disk between boots.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-lab/vm"

# Each instance gets its own ssh port from here up, picked once by `new`.
# 2223 is the nixos lab and 2224 the arm image builder.
FIRST_PORT=2230

usage() {
    cat <<EOF
usage: ${0##*/} <command> [args]

instances:
  new <distro> [name]    create an instance (name defaults to the distro),
                         boot it, provision the primary user and ansible
                         via cloud-init, copy the repo to ~/dotfiles and
                         open a shell
  start <name>           boot an existing instance and open a shell
  stop <name>            shut the instance down cleanly
  rm <name>              delete a stopped instance and its disk
  list                   show the instances, their ports and state

  new and start take --headless to run without a window.

in a running instance:
  shell <name>           open another shell
  sync <name>            copy the repo to ~/dotfiles again
  screenshot <name> [file]
                         dump the virtual monitor to a png. Needs the 2d
                         display (--headless or macos), qemu can't dump
                         the 3d one

snapshots (the instance must be stopped):
  snapshot <name> [tag]  save the disk as <tag>, or list the snapshots
  revert <name> <tag>    put the disk back to <tag>

distros:
  archlinux              the official x86_64 cloud image -- mainline
                         arch, so unlike the container lab nothing needs
                         to be excluded
  archlinux-arm          an aarch64 image lib/build-arm-image assembles
                         from the arch linux arm rootfs tarball

The vm runs accelerated when host and guest architectures match (kvm on
linux, hvf on macos) and falls back to slow emulation otherwise. State
lives under $CACHE: one directory per instance, and base/ for the
downloaded images. Every instance disk is a thin layer on top of its base
image, so never delete or replace a base image while instances use it.

On a linux host the window opens fullscreen with 3d graphics and takes
the keyboard. Ctrl+Alt+F leaves fullscreen and gives the keyboard back.
The guest screen then follows the window size.

environment:
  LAB_VM_CPUS  vcpus for the vm (default: half the host's cpus)
  LAB_VM_MEM   memory for the vm in MiB (default: half the host's memory)
  LAB_VM_RES   display resolution as WIDTHxHEIGHT (default: 1920x1080);
               the fullscreen linux window overrides it with the screen size
EOF
}

die() { echo "${0##*/}: $*" >&2; exit 1; }


# Instances
# ---------------------------------------------
# Sets guest_arch and img_url for a distro.
distro_info() {
    case "$1" in
        archlinux)
            guest_arch=x86_64
            img_url="https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"
            ;;
        archlinux-arm)
            guest_arch=aarch64
            img_url=        # no upstream image, lib/build-arm-image makes one
            ;;
        *) die "unknown distro '$1' (try: ${0##*/} help)" ;;
    esac
}

# Sets everything the other commands need to talk to instance $1.
load_instance() {
    name="${1:-}"
    [ -n "$name" ] || die "missing instance name (try: ${0##*/} list)"
    valid_name "$name" && [ -d "$CACHE/$name" ] || die "no instance '$name' (try: ${0##*/} list)"
    vm="$CACHE/$name"

    # A directory from before instances existed: the name was the distro
    # and the port was 2222.
    if [ ! -f "$vm/distro" ]; then
        ( distro_info "$name" ) 2>/dev/null || die "'$vm' is not an instance"
        echo "$name" > "$vm/distro"
        echo 2222 > "$vm/port"
    fi

    distro="$(cat "$vm/distro")"
    port="$(cat "$vm/port")"
    distro_info "$distro"
    base="$CACHE/base/$distro.qcow2"
    qemu="qemu-system-$guest_arch"
    ssh_opts=(-p "$port" -i "$vm/key" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no
              -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR
              -o ServerAliveInterval=15)
}

# Names become directory names, so they can't contain a slash or start
# with a dot.
valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9.-]*$ ]] && [ "$1" != base ]; }

instances() {
    local d
    for d in "$CACHE"/*/; do
        d="${d%/}"; d="${d##*/}"
        [ "$d" = base ] || [ "$d" = '*' ] || echo "$d"
    done
}

# The first port from FIRST_PORT up that no instance has taken.
free_port() {
    local p="$FIRST_PORT"
    while cat "$CACHE"/*/port 2>/dev/null | grep -qx "$p"; do
        p=$(( p + 1 ))
    done
    echo "$p"
}

running() { [ -f "$vm/pid" ] && kill -0 "$(cat "$vm/pid")" 2>/dev/null; }

need_running() { running || die "'$name' is not running -- run: ${0##*/} start $name"; }
need_stopped() { ! running || die "'$name' is running -- run: ${0##*/} stop $name"; }

vm_ssh() {  # vm_ssh [-t] cmd...
    local tty=()
    [ "${1:-}" = -t ] && { tty=(-t); shift; }
    ssh "${tty[@]}" "${ssh_opts[@]}" dev@127.0.0.1 "$@"
}

# qmp <command> [json arguments]: run one command on the instance's monitor.
qmp() {
    local args="${2:-}"
    [ -n "$args" ] || args='{}'
    python3 - "$vm/qmp.sock" "$1" "$args" <<'EOF'
import json, socket, sys
sock, command, args = sys.argv[1], sys.argv[2], json.loads(sys.argv[3])
s = socket.socket(socket.AF_UNIX)
s.connect(sock)
f = s.makefile("rw")
json.loads(f.readline())  # greeting
def cmd(c):
    f.write(json.dumps(c) + "\n"); f.flush()
    while True:
        r = json.loads(f.readline())
        if "return" in r or "error" in r:
            return r
cmd({"execute": "qmp_capabilities"})
r = cmd({"execute": command, "arguments": args})
if "error" in r:
    sys.exit(command + " failed: " + r["error"]["desc"])
EOF
}


# Host
# ---------------------------------------------
firmware() {
    local f
    for f in /opt/homebrew/share/qemu/edk2-aarch64-code.fd \
             /usr/share/qemu/edk2-aarch64-code.fd \
             /usr/share/AAVMF/AAVMF_CODE.fd \
             /usr/share/edk2/aarch64/QEMU_EFI.fd; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
    die "no aarch64 uefi firmware found (install qemu's edk2 firmware)"
}

accel_args() {
    # uname says arm64 where qemu says aarch64
    local host="$(uname -m)"; [ "$host" = arm64 ] && host=aarch64
    if [ "$host" = "$guest_arch" ]; then
        case "$(uname -s)" in
            Darwin) echo "-accel hvf -cpu host" ;;
            Linux)  echo "-accel kvm -cpu host" ;;
        esac
    else
        # cross-arch emulation: correct but slow, fine for occasional runs
        echo "-accel tcg -cpu max"
    fi
}

host_cpus() { getconf _NPROCESSORS_ONLN; }

host_mem_mib() {
    case "$(uname -s)" in
        Darwin) echo $(( $(sysctl -n hw.memsize) / 1048576 )) ;;
        Linux)  awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo ;;
    esac
}

# Half the host by default, so a build in the guest cannot starve it.
vm_size() {
    local half_cpus=$(( $(host_cpus) / 2 )) half_mem=$(( $(host_mem_mib) / 2 ))
    cpus="${LAB_VM_CPUS:-$(( half_cpus > 0 ? half_cpus : 1 ))}"
    mem="${LAB_VM_MEM:-$half_mem}"
    [[ "$cpus" =~ ^[1-9][0-9]*$ ]] || die "LAB_VM_CPUS must be a positive integer, got '$cpus'"
    [[ "$mem" =~ ^[1-9][0-9]*$ ]] || die "LAB_VM_MEM must be a positive integer (MiB), got '$mem'"
}

# The preferred mode virtio-gpu advertises over edid; qemu's own is 1280x800.
vm_resolution() {
    local res="${LAB_VM_RES:-1920x1080}"
    [[ "$res" =~ ^([1-9][0-9]*)x([1-9][0-9]*)$ ]] \
        || die "LAB_VM_RES must look like 1920x1080, got '$res'"
    xres="${BASH_REMATCH[1]}" yres="${BASH_REMATCH[2]}"
}

graphical_session() {
    if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
        return
    fi
    local var val found=()
    for var in WAYLAND_DISPLAY DISPLAY; do
        val="$(systemctl --user show-environment 2>/dev/null | sed -n "s/^$var=//p")" || true
        [ -n "$val" ] || continue
        export "$var=$val"
        found+=("$var=$val")
    done
    [ "${#found[@]}" -gt 0 ] \
        || die "no desktop session to open the window on (try --headless)"
    echo "warning: this shell has no WAYLAND_DISPLAY or DISPLAY (ssh?)," \
         "using the desktop session's: ${found[*]}" >&2
}

# The window needs a linux host with a desktop; macos uses qemu's own.
wants_gl() { [ "$headless" = false ] && [ "$(uname -s)" = Linux ]; }

# Checks that can fail, run before anything is created or booted.
preflight() {
    command -v "$qemu" >/dev/null \
        || die "$qemu not found (install qemu: brew install qemu / pacman -S qemu-desktop)"
    vm_size
    vm_resolution
    if wants_gl; then
        graphical_session
    fi
}


# Provisioning
# ---------------------------------------------
make_seed() {
    ssh-keygen -q -t ed25519 -N "" -f "$vm/key"
    mkdir -p "$vm/seed"
    # replaces the image's default user, so ours gets uid 1000
    cat > "$vm/seed/user-data" <<EOF
#cloud-config
users:
  - name: dev
    groups: wheel
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - $(cat "$vm/key.pub")
runcmd:
  - pacman -Syu --noconfirm ansible
EOF
    printf 'instance-id: lab-vm-%s\nlocal-hostname: lab-vm-%s\n' \
        "$name" "$name" > "$vm/seed/meta-data"

    # cloud-init's nocloud source wants an iso labeled cidata
    if command -v hdiutil >/dev/null; then
        hdiutil makehybrid -quiet -iso -joliet -default-volume-name cidata \
            -o "$vm/seed.iso" "$vm/seed"
    elif command -v xorriso >/dev/null; then
        xorriso -as mkisofs -quiet -V cidata -J -r -o "$vm/seed.iso" "$vm/seed"
    elif command -v mkisofs >/dev/null; then
        mkisofs -quiet -V cidata -J -r -o "$vm/seed.iso" "$vm/seed"
    else
        die "need hdiutil, xorriso or mkisofs to build the cloud-init seed"
    fi
}

fetch_base() {
    [ -f "$base" ] && return
    mkdir -p "$CACHE/base"
    if [ -n "$img_url" ]; then
        echo "downloading $img_url"
        curl -fL --progress-bar -o "$base.part" "$img_url" && mv "$base.part" "$base"
    else
        echo "no $distro image yet, building one"
        "$HERE/lib/build-arm-image"
    fi
}

copy_repo() {
    # what a fresh clone would contain plus new files not yet committed;
    # macOS tar needs to be told not to smuggle in apple metadata
    local tarflags=(--no-xattrs)
    tar --version | grep -q bsdtar && tarflags+=(--no-mac-metadata)

    git -C "$REPO" ls-files -z --cached --others --exclude-standard \
        | while IFS= read -r -d '' f; do
              { [ -e "$REPO/$f" ] || [ -h "$REPO/$f" ]; } && printf '%s\0' "$f"
          done \
        | tar -C "$REPO" "${tarflags[@]}" --null -T - -czf - \
        | vm_ssh 'rm -rf ~/dotfiles && mkdir -p ~/dotfiles && tar -xzf - -C ~/dotfiles'
}


# Booting
# ---------------------------------------------
boot() {
    echo "booting $name at $cpus vcpus, $mem MiB, ${xres}x${yres}, ssh port $port"

    # the virt machine has no ide to hang the seed off, so there the seed
    # rides on virtio
    local platform=(-machine q35 -vga none -cdrom "$vm/seed.iso")
    local gpu=virtio-vga
    if [ "$guest_arch" = aarch64 ]; then
        gpu=virtio-gpu-pci
        platform=(-machine virt
                  -drive if=pflash,format=raw,readonly=on,file="$(firmware)"
                  -drive if=pflash,format=raw,file="$vm/vars.fd"
                  -drive if=virtio,file="$vm/seed.iso",format=raw,readonly=on)
    fi

    local input=(-device qemu-xhci -device usb-kbd -device usb-tablet)

    local display=()
    if [ "$headless" = true ]; then
        display=(-display none)
    elif wants_gl; then
        case "$gpu" in
            virtio-vga)     gpu=virtio-vga-gl ;;
            virtio-gpu-pci) gpu=virtio-gpu-gl-pci ;;
        esac
        display=(-display sdl,gl=on -full-screen)
        export SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
    fi

    # shellcheck disable=SC2046
    "$qemu" \
        -name "lab-vm-$name" -m "$mem" -smp "$cpus" \
        "${platform[@]}" \
        $(accel_args) \
        -drive if=virtio,file="$vm/disk.qcow2",format=qcow2 \
        -device "$gpu",xres="$xres",yres="$yres" -device virtio-rng-pci \
        "${input[@]}" \
        -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$port-:22" \
        -qmp "unix:$vm/qmp.sock,server,nowait" \
        -serial "file:$vm/serial.log" \
        -pidfile "$vm/pid" \
        "${display[@]}" </dev/null >"$vm/qemu.log" 2>&1 &

    sleep 2
    if ! running; then
        cat "$vm/qemu.log" >&2
        die "qemu did not start (see $vm/qemu.log and $vm/serial.log)"
    fi

    echo -n "waiting for ssh"
    local i
    for i in $(seq 1 120); do
        vm_ssh -o ConnectTimeout=2 true </dev/null 2>/dev/null && break
        echo -n .; sleep 5
        [ "$i" = 120 ] && die "vm never came up (see $vm/serial.log)"
    done
    echo " up"
}


# Commands
# ---------------------------------------------
cmd_new() {
    local new_distro="${1:-}"
    [ -n "$new_distro" ] || die "missing distro (try: ${0##*/} help)"
    distro_info "$new_distro"
    name="${2:-$new_distro}"
    valid_name "$name" \
        || die "instance names are lowercase letters, digits, dots and dashes, got '$name'"
    vm="$CACHE/$name"
    [ ! -e "$vm" ] || die "instance '$name' already exists (${0##*/} start $name, or ${0##*/} rm $name)"

    distro="$new_distro"
    qemu="qemu-system-$guest_arch"
    base="$CACHE/base/$distro.qcow2"
    local cpus mem xres yres
    preflight
    fetch_base

    mkdir -p "$vm"
    echo "$distro" > "$vm/distro"
    free_port > "$vm/port"
    load_instance "$name"
    qemu-img create -q -f qcow2 -F qcow2 -b "$base" "$vm/disk.qcow2" 40G
    if [ "$guest_arch" = aarch64 ]; then
        dd if=/dev/zero of="$vm/vars.fd" bs=1m count=64 status=none
    fi
    make_seed

    boot
    echo "waiting for cloud-init to install ansible"
    # The instance stays when this fails, so it can be fixed by hand (a slow
    # mirror is the usual cause) and finished with `sync`.
    vm_ssh sudo cloud-init status --wait </dev/null >/dev/null \
        || die "cloud-init failed on '$name' (${0##*/} shell $name, then: cloud-init status --long)"
    copy_repo
    echo "new $distro instance '$name', repo copied to ~/dotfiles -- try:"
    echo "    ansible-playbook ansible/base.yml"
    cmd_shell
}

cmd_start() {
    load_instance "$1"
    running && die "'$name' is already running -- ${0##*/} shell $name"
    local cpus mem xres yres
    preflight
    boot
    cmd_shell
}

cmd_shell() {
    need_running
    if [ -t 0 ]; then
        vm_ssh -t 'cd ~/dotfiles 2>/dev/null; exec bash'
    else
        vm_ssh bash
    fi
}

cmd_sync() {
    need_running
    copy_repo
    echo "repo copied to ~/dotfiles on '$name'"
}

cmd_stop() {
    if ! running; then
        echo "'$name' is not running"
        return
    fi
    qmp system_powerdown
    echo -n "shutting down $name"
    local i
    for i in $(seq 1 60); do
        running || { echo " done"; return; }
        echo -n .; sleep 1
    done
    echo " no response, killing it"
    kill "$(cat "$vm/pid")"
}

cmd_rm() {
    need_stopped
    rm -rf "$vm"
    echo "deleted '$name'"
}

cmd_list() {
    local n state
    printf '%-20s %-15s %-6s %s\n' NAME DISTRO PORT STATE
    for n in $(instances); do
        if [ ! -f "$CACHE/$n/distro" ] && ! ( distro_info "$n" ) 2>/dev/null; then
            printf '%-20s %s\n' "$n" "(not an instance)"
            continue
        fi
        load_instance "$n"
        state=stopped; running && state=running
        printf '%-20s %-15s %-6s %s\n' "$name" "$distro" "$port" "$state"
    done
}

cmd_screenshot() {
    need_running
    local out="${1:-$vm/screen.png}"
    qmp screendump "{\"filename\": \"$out\", \"format\": \"png\"}"
    echo "$out"
}

# Snapshots live inside the instance's disk (qcow2 internal snapshots).
cmd_snapshot() {
    need_stopped
    if [ -z "${1:-}" ]; then
        qemu-img snapshot -l "$vm/disk.qcow2"
    else
        qemu-img snapshot -c "$1" "$vm/disk.qcow2"
        echo "saved '$name' as '$1'"
    fi
}

cmd_revert() {
    need_stopped
    [ -n "${1:-}" ] || die "missing snapshot tag (try: ${0##*/} snapshot $name)"
    qemu-img snapshot -a "$1" "$vm/disk.qcow2"
    echo "'$name' is back at '$1'"
}


# Main
# ---------------------------------------------
# --headless can go anywhere on the command line
headless=false
args=()
for a in "$@"; do
    if [ "$a" = --headless ]; then headless=true; else args+=("$a"); fi
done
set -- "${args[@]}"

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    ''|help|-h|--help) usage ;;
    new)        cmd_new "$@" ;;
    list)       cmd_list ;;
    start)      cmd_start "${1:-}" ;;
    shell)      load_instance "${1:-}"; cmd_shell ;;
    sync)       load_instance "${1:-}"; cmd_sync ;;
    stop)       load_instance "${1:-}"; cmd_stop ;;
    rm)         load_instance "${1:-}"; cmd_rm ;;
    screenshot) load_instance "${1:-}"; cmd_screenshot "${2:-}" ;;
    snapshot)   load_instance "${1:-}"; cmd_snapshot "${2:-}" ;;
    revert)     load_instance "${1:-}"; cmd_revert "${2:-}" ;;
    *) die "unknown command '$cmd' (try: ${0##*/} help)" ;;
esac
