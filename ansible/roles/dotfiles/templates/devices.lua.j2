return {
{% for device, options in (input_devices | default({})).items() %}
	[{{ device | to_json }}] = { {% for key, value in options.items() %}{{ key }} = {{ lua(value) }}{{ ", " if not loop.last }}{% endfor %} },
{% endfor %}
}
