{#- A yaml value as a lua literal: booleans, numbers, strings and lists. -#}
{%- macro lua(value) -%}
{%- if value is sameas true or value is sameas false -%}
{{ value | lower }}
{%- elif value is number -%}
{{ value }}
{%- elif value is string -%}
{{ value | to_json }}
{%- else -%}
{ {% for item in value %}{{ lua(item) }}{{ ", " if not loop.last }}{% endfor %} }
{%- endif -%}
{%- endmacro -%}
