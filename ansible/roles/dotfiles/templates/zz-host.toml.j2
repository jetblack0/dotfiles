# Host overlay, rendered by ansible (roles/dotfiles/tasks/noctalia.yml)
# ---------------------------------------------
# Do not edit in place: the next playbook run rewrites this file.

[wallpaper]
directory = "{{ wallpaper_directory }}"

# Empty resolves to the XDG Pictures directory (ScreenshotConfig).
[shell.screenshot]
directory = "{{ screenshot_directory }}"

# Empty resolves to the recorder plugin's ~/Videos/Recordings.
[plugin_settings."noctalia/screen_recorder"]
directory = "{{ recording_directory }}"

# Lock screen login box
# ---------------------------------------------
{% for monitor in monitors | default([]) if monitor.output | default('') %}

[lockscreen_widgets.widget."lockscreen-login-box@{{ monitor.output }}"]
box_height = 70.0
box_width = 240.0
cx = 800.0
cy = 913.0
enabled = true
output = "{{ monitor.output }}"
placement_height = 1000.0
placement_width = 1600.0
rotation = 0.0
type = "login_box"

    [lockscreen_widgets.widget."lockscreen-login-box@{{ monitor.output }}".settings]
    background_color = "surface_variant"
    background_opacity = 0.0
    background_radius = 12.0
    center_password_text = false
    input_opacity = 0.59999999999999998
    input_radius = 6.0
    layout = "compact"
    show_caps_lock = true
    show_keyboard_layout = true
    show_login_button = false
    show_media = true
    show_session_buttons = true
    show_unlock_hint = false
    show_weather = true
{% endfor %}

# Lock screen clock and date
# ---------------------------------------------
# One clock and one date per declared monitor, bound to it, so every screen
# shows them (an unbound widget lands on just one screen). A widget bound to
# a screen that is unplugged is hidden, not moved, so nothing doubles up on
# the laptop panel. Without monitors, one unbound pair as before.
{% set lock_outputs = (monitors | default([]) | map(attribute='output', default='') | select | list) or [''] %}
{% for out in lock_outputs %}
{% set sfx = ('@' ~ out) if out else '' %}

[lockscreen_widgets.widget."lockscreen-clock{{ sfx }}"]
box_height = {{ (lockscreen_height * 0.161) | round(1) if lockscreen_height is defined else 161.0 }}
box_width = 560.0
cx = 800.0
cy = 196.0
enabled = true
output = "{{ out }}"
placement_height = 1000.0
placement_width = 1600.0
rotation = 0.0
type = "clock"

    [lockscreen_widgets.widget."lockscreen-clock{{ sfx }}".settings]
    background = false
    center_text = true
    clock_style = "digital"
    color = "#cfcfcfe6"
    font_family = "SF Pro Display Clock"
    shadow = false

[lockscreen_widgets.widget."lockscreen-date{{ sfx }}"]
box_height = {{ (lockscreen_height * 0.038) | round(1) if lockscreen_height is defined else 38.0 }}
box_width = 480.0
cx = 800.0
cy = 112.0
enabled = true
output = "{{ out }}"
placement_height = 1000.0
placement_width = 1600.0
rotation = 0.0
type = "clock"

    [lockscreen_widgets.widget."lockscreen-date{{ sfx }}".settings]
    background = false
    center_text = true
    color = "#bdbdbdd9"
    font_family = "SF Pro Display Clock"
    format = "{:%A, %B %-d}"
    shadow = false
{% endfor %}

# Media widget width
# ---------------------------------------------
# The media widget sits in the left half of the bar, after the window title.
# Its cap is in pixels (times the bar scale), so it depends on the screen's
# logical width. Unset keeps the value in config.toml.
{% if media_max_length is defined %}

[widget.media]
max_length = {{ media_max_length }}
{% endif %}
